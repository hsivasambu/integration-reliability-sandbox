{
  "name": "integration-reliability-sandbox",
  "version": "0.12.0",
  "private": true,
  "description": "Synthetic event delivery sandbox for learning integration reliability.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "dev:migrate": "node --env-file-if-exists=.env src/migrate.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\"",
    "receiver:try": "node --env-file-if-exists=.env scripts/try-receiver.js",
    "worker": "node src/worker-main.js",
    "dev:worker": "node --env-file-if-exists=.env src/worker-main.js",
    "test:browser": "node --test --test-concurrency=1 test/browser/fixtures.browser.js",
    "test:live": "node --env-file-if-exists=.env --test --test-concurrency=1 test/browser/live.browser.js"
  },
  "engines": {
    "node": ">=22.9 <25"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "swagger-ui-dist": "5.33.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  }
}
