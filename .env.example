# Copy to .env for local development. Never commit .env.
# npm run dev, npm run dev:migrate, npm test and docker compose all read it.

# --- Web server ---
# Port the server listens on. Render sets PORT itself (default 10000).
PORT=3000
# Listen address. Use 127.0.0.1 locally to stay off your network.
# Hosting needs 0.0.0.0, which is the default when HOST is unset.
HOST=127.0.0.1

# --- Local Postgres container (docker compose) ---
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# --- App database connections (use the same password as above) ---
DATABASE_URL=postgres://sandbox:replace-with-a-local-password@127.0.0.1:5433/sandbox
TEST_DATABASE_URL=postgres://sandbox:replace-with-a-local-password@127.0.0.1:5433/sandbox_test

# Apply pending migrations when the server starts (used on Render free plan).
MIGRATE_ON_START=false

# --- Demo sessions (optional; defaults shown) ---
# SESSION_TTL_HOURS=24
# SESSION_RATE_LIMIT_MAX=10
# SESSION_RATE_LIMIT_WINDOW_MINUTES=60
# MAX_ACTIVE_SESSIONS=1000
# Number of proxies in front of the app (0 locally; 1 on Render).
# TRUST_PROXY=0
