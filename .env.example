# Copy to .env for local development. Never commit .env.
# npm run dev, npm run dev:migrate, npm test and docker compose all read it.

# --- Web server ---
# Port the server listens on. Render sets PORT itself (default 10000).
PORT=3000
# Listen address. Use 127.0.0.1 locally to stay off your network.
# Hosting needs 0.0.0.0, which is the default when HOST is unset.
HOST=127.0.0.1

# --- Local Postgres container (docker compose) ---
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# --- App database connections (use the same password as above) ---
DATABASE_URL=postgres://sandbox:replace-with-a-local-password@127.0.0.1:5433/sandbox
TEST_DATABASE_URL=postgres://sandbox:replace-with-a-local-password@127.0.0.1:5433/sandbox_test

# Apply pending migrations when the server starts (used on Render free plan).
MIGRATE_ON_START=false

# --- Demo sessions (optional; defaults shown) ---
# SESSION_TTL_HOURS=24
# SESSION_RATE_LIMIT_MAX=10
# SESSION_RATE_LIMIT_WINDOW_MINUTES=60
# MAX_ACTIVE_SESSIONS=1000
# MAX_EVENTS_PER_SESSION=100
# Number of proxies in front of the app (0 locally; 1 on Render).
# TRUST_PROXY=0

# --- Mock receiver ---
# Required. Server-side secret for internal receiver calls, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RECEIVER_SECRET=replace-with-a-generated-secret-of-32-plus-chars
# Optional (defaults shown). Destination defaults to this app's own receiver over loopback.
# RECEIVER_URL=http://127.0.0.1:3000/internal/receiver/deliveries
# DELIVERY_TIMEOUT_MS=2000
# RECEIVER_SLOW_RESPONSE_MS=4000

# --- Delivery worker ---
# true = run the worker inside the web server process. Locally you can instead leave it false
# and run "npm run dev:worker" in a second terminal.
WORKER_ENABLED=false
# WORKER_POLL_INTERVAL_MS=1000
# DELIVERY_LEASE_MS=15000
# DELIVERY_MAX_ATTEMPTS=3
